# Webull OpenAPI Credentials
# Get these from https://www.webull.com/center#openApiManagement (or your region's portal)
WEBULL_APP_KEY=your_app_key_here
WEBULL_APP_SECRET=your_app_secret_here

# Region: us, hk, jp, sg, th, au, my, uk, etc.
WEBULL_REGION=us

# Endpoint - ALWAYS start with sandbox!
# Sandbox: api.sandbox.webull.com
# Production: api.webull.com
WEBULL_ENDPOINT=api.sandbox.webull.com

# Optional: specific account ID. Leave blank to use the first account returned.
WEBULL_ACCOUNT_ID=

# Optional: default symbol for strategy runs
DEFAULT_SYMBOL=AAPL
